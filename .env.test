# Test environment variables
# Used by: make test-live, make test-db-up
# Safe to commit — test credentials only, never used in production

DATABASE_URL=postgres://azimuthal_test:testpassword@localhost:5433/azimuthal_test?sslmode=disable
STORAGE_ENDPOINT=http://localhost:9001
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=azimuthal-test
APP_ENV=test
APP_PORT=8081
LOG_LEVEL=error

# The auth rate limiter is per client IP, and a test harness drives the whole
# suite from a single IP (loopback), so a per-IP bucket would refuse legitimate
# test traffic once a spec's logins outran the burst. Disabled here; the
# limiter's own behaviour is covered by the Go unit/integration tests, where the
# IP is controllable. The CI e2e job sets this in its own env block (it launches
# the binary directly rather than through a make target that exports this file).
AZIMUTHAL_AUTH_RATE_LIMIT_ENABLED=false
