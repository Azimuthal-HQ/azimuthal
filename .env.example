# Azimuthal — environment variables
# Copy this file to .env and fill in your values.
#
# Every setting below is forwarded into the container by build/docker-compose.yml.
# Anything commented out is left unset, and the binary uses the default shown —
# the defaults here are for reference only, and the application supplies them,
# so uncommenting a line with its default value changes nothing.
#
# The full reference, with what each setting does, is in docs/self-hosting.md.
# There is no JWT secret to generate: JWT signing uses an RS256 key pair that
# the server creates and stores in the database on first start (ADR-0004).

# --- Required ---
POSTGRES_PASSWORD=change-me-use-a-strong-password
MINIO_ROOT_USER=azimuthal
MINIO_ROOT_PASSWORD=change-me-use-a-strong-password

# --- Compose-level ---
# The published host port, and the image tag to run. Neither is read by the
# application; APP_PORT inside the container is always 8080.
# APP_PORT=8080
# :latest is only reassigned once the GitHub Release for that version exists, and
# never backwards onto an older version — so it always names a released build,
# and a backport release cannot walk you down a version. Pin an explicit tag
# (AZIMUTHAL_VERSION=v0.4.1) if you want upgrades to be a decision, not a pull.
# AZIMUTHAL_VERSION=latest

# --- Core ---
# Public URL of this instance. Used to build the links that go out in invites
# and portal sign-in emails, so a wrong value produces links nobody can follow.
# APP_BASE_URL=http://localhost:8080
# Log verbosity: debug, info, warn, error (any case). An unrecognised value is
# refused at startup.
# LOG_LEVEL=info

# --- Object storage ---
# STORAGE_BUCKET=azimuthal
# Reach the endpoint over TLS. The bundled stack talks to MinIO over the compose
# network, so this stays false; an https:// endpoint forces it true regardless.
# STORAGE_USE_SSL=false

# --- Authentication and access ---
# Password hashing work factor. 12 is the floor; lower is refused at startup,
# in every environment. Up-only — raise it as hardware gets faster.
# AZIMUTHAL_BCRYPT_COST=12
# Comma-separated CORS allow-list. Empty means no CORS headers are emitted and
# the browser enforces same-origin, which is correct for the bundled stack
# because the frontend is served by the same binary. "*" matches any origin.
# AZIMUTHAL_ALLOWED_ORIGINS=
# Opens POST /auth/register. Off by default: the endpoint 404s and invites are
# the only way in.
# AZIMUTHAL_ALLOW_REGISTRATION=false
# Access-token lifetime (Go duration).
# JWT_EXPIRY=24h
# One-time import path for a legacy file-based RS256 key. Not required.
# JWT_PRIVATE_KEY_PATH=./data/jwt-private.pem

# --- Invitations and the customer portal ---
# link = an admin copies the one-time URL; email = Azimuthal sends it.
# email requires SMTP_HOST and SMTP_FROM to be set explicitly below, or startup
# fails rather than dropping invites at send time.
# AZIMUTHAL_INVITE_DELIVERY=link
# AZIMUTHAL_INVITE_TTL=168h
# The same two modes for customer-portal sign-in links, with the same SMTP
# requirement for email. This setting does NOT decide whether the sign-in URL is
# disclosed in the API response — the flag below does.
# AZIMUTHAL_PORTAL_LINK_DELIVERY=link
# Return the portal sign-in URL in the body of the unauthenticated request-link
# response. Default false, and leave it there: that endpoint takes any email
# address, so a disclosed URL signs the caller in as anyone they can name. It is
# ignored in this stack anyway — APP_ENV is production in the compose file, and
# disclosure needs the flag AND a non-production environment; the server logs a
# warning naming both variables if you set it here.
# AZIMUTHAL_PORTAL_DISCLOSE_LINK=false
# AZIMUTHAL_PORTAL_LINK_TTL=1h
# AZIMUTHAL_PORTAL_SESSION_TTL=72h

# --- Email ---
# Leave SMTP_HOST unset unless you have a relay. It is how the server tells
# "a relay was configured" from "nothing was set", so setting it to localhost
# without a listener there makes email delivery modes pass their startup check
# and then fail silently at send time.
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_FROM=azimuthal@localhost

# --- Operations ---
# Require an operator ticket reference on every administrative change.
# Boot-time; turning it on is a production cutover. See docs/self-hosting.md.
# AZIMUTHAL_TICKET_REF_REQUIRED=false
# The background job queue. Off disables notifications and scheduled work.
# AZIMUTHAL_QUEUE_ENABLED=true
